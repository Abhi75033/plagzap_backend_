const jwt = require('jsonwebtoken');
const Meeting = require('../models/Meeting');

/**
 * Socket.IO Video Signaling Controller
 * Handles WebRTC signaling for Google Meet-style video conferencing
 */

module.exports = (io) => {
    // JWT Auth Middleware for Socket.IO
    io.use((socket, next) => {
        const token = socket.handshake.auth.token;

        if (!token) {
            return next(new Error('Authentication error: No token provided'));
        }

        try {
            const decoded = jwt.verify(token, process.env.JWT_SECRET);
            socket.userId = decoded.id;
            socket.userName = decoded.name || 'Guest';
            next();
        } catch (err) {
            next(new Error('Authentication error: Invalid token'));
        }
    });

    // Room state: meetingCode -> Map of socketId -> user data
    const meetings = new Map();

    // Helper: Get participants in a meeting
    const getParticipants = (meetingCode) => {
        if (!meetings.has(meetingCode)) {
            meetings.set(meetingCode, new Map());
        }
        return Array.from(meetings.get(meetingCode).values());
    };

    io.on('connection', (socket) => {
        console.log(`✅ User connected: ${socket.userName} (${socket.id})`);

        // Join room
        socket.on('join-room', async ({ meetingCode, userName }) => {
            try {
                console.log(`📞 ${userName} joining room: ${meetingCode}`);

                // Find meeting
                const meeting = await Meeting.findOne({ code: meetingCode });
                if (!meeting) {
                    socket.emit('error', { message: 'Meeting not found' });
                    return;
                }

                // Check if meeting has ended
                if (meeting.status === 'ended') {
                    socket.emit('meeting-ended', {
                        message: 'This meeting has ended. The host has left.'
                    });
                    return;
                }

                // Check if user is the host
                const isHost = meeting.host.toString() === socket.userId.toString(); // Changed socket.user.id to socket.userId

                // Join socket room
                socket.join(meetingCode);
                meeting.status = 'active';
                await meeting.save();
            }

        console.log(`📹 ${socket.userName} joined meeting: ${meetingCode}`);
        } catch (error) {
            console.error('Error joining meeting:', error);
            socket.emit('error', { message: 'Failed to join meeting' });
        }
    });

    // WebRTC Signaling: Offer
    socket.on('offer', ({ to, offer }) => {
        console.log(`📡 Offer from ${socket.id} to ${to}`);
        io.to(to).emit('offer', {
            from: socket.id,
            offer,
            userName: socket.userName
        });
    });

    // WebRTC Signaling: Answer
    socket.on('answer', ({ to, answer }) => {
        console.log(`📡 Answer from ${socket.id} to ${to}`);
        io.to(to).emit('answer', {
            from: socket.id,
            answer
        });
    });

    // WebRTC Signaling: ICE Candidate
    socket.on('ice-candidate', ({ to, candidate }) => {
        io.to(to).emit('ice-candidate', {
            from: socket.id,
            candidate
        });
    });

    // Toggle Audio
    socket.on('toggle-audio', ({ enabled }) => {
        if (socket.currentMeeting && meetings.has(socket.currentMeeting)) {
            const participant = meetings.get(socket.currentMeeting).get(socket.id);
            if (participant) {
                participant.audioEnabled = enabled;
                socket.to(socket.currentMeeting).emit('participant-audio-changed', {
                    socketId: socket.id,
                    enabled
                });
            }
        }
    });

    // Toggle Video
    socket.on('toggle-video', ({ enabled }) => {
        if (socket.currentMeeting && meetings.has(socket.currentMeeting)) {
            const participant = meetings.get(socket.currentMeeting).get(socket.id);
            if (participant) {
                participant.videoEnabled = enabled;
                socket.to(socket.currentMeeting).emit('participant-video-changed', {
                    socketId: socket.id,
                    enabled
                });
            }
        }
    });

    // Screen Sharing
    socket.on('screen-share-started', () => {
        if (socket.currentMeeting && meetings.has(socket.currentMeeting)) {
            const participant = meetings.get(socket.currentMeeting).get(socket.id);
            if (participant) {
                participant.screenSharing = true;
                socket.to(socket.currentMeeting).emit('participant-screen-share-started', {
                    socketId: socket.id,
                    userName: socket.userName
                });
            }
        }
    });

    socket.on('screen-share-stopped', () => {
        if (socket.currentMeeting && meetings.has(socket.currentMeeting)) {
            const participant = meetings.get(socket.currentMeeting).get(socket.id);
            if (participant) {
                participant.screenSharing = false;
                socket.to(socket.currentMeeting).emit('participant-screen-share-stopped', {
                    socketId: socket.id
                });
            }
        }
    });

    // Raise Hand
    socket.on('raise-hand', ({ raised }) => {
        if (socket.currentMeeting && meetings.has(socket.currentMeeting)) {
            const participant = meetings.get(socket.currentMeeting).get(socket.id);
            if (participant) {
                participant.handRaised = raised;
                socket.to(socket.currentMeeting).emit('participant-hand-raised', {
                    socketId: socket.id,
                    userName: socket.userName,
                    raised
                });
            }
        }
    });

    // Chat Message
    socket.on('chat-message', ({ message }) => {
        if (socket.currentMeeting) {
            const chatMessage = {
                id: Date.now().toString(),
                userId: socket.userId,
                userName: socket.userName,
                message,
                timestamp: new Date().toISOString()
            };

            // Broadcast to everyone including sender
            io.to(socket.currentMeeting).emit('chat-message', chatMessage);
            console.log(`💬 Chat from ${socket.userName}: ${message}`);
        }
    });

    // Leave Meeting
    socket.on('leave-meeting', () => {
        handleDisconnect(socket);
    });

    // Disconnect
    socket.on('disconnect', () => {
        handleDisconnect(socket);
    });

    // Helper: Handle participant leaving
    function handleDisconnect(socket) {
        if (socket.currentMeeting && meetings.has(socket.currentMeeting)) {
            const meetingCode = socket.currentMeeting;
            const meetingParticipants = meetings.get(meetingCode);

            meetingParticipants.delete(socket.id);

            // Notify others
            socket.to(meetingCode).emit('user-left', {
                socketId: socket.id,
                userName: socket.userName
            });

            // Clean up empty meetings
            if (meetingParticipants.size === 0) {
                meetings.delete(meetingCode);
                console.log(`🗑️  Meeting ${meetingCode} removed (no participants)`);
            }

            console.log(`👋 ${socket.userName} left meeting: ${meetingCode}`);
        }

        console.log(`❌ User disconnected: ${socket.userName} (${socket.id})`);
    }
});

// Cleanup interval: every 5 minutes
setInterval(() => {
    const count = meetings.size;
    if (count > 0) {
        console.log(`📊 Active meetings: ${count}`);
    }
}, 5 * 60 * 1000);
};
